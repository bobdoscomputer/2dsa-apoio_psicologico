{
  "name": "QuizResult",
  "type": "object",
  "properties": {
    "score": {
      "type": "number"
    },
    "max_score": {
      "type": "number"
    },
    "level": {
      "type": "string",
      "enum": [
        "baixo",
        "moderado",
        "alto",
        "muito_alto"
      ]
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "number"
          }
        }
      }
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "score",
    "level",
    "date"
  ]
}

{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "psychologist_id": {
      "type": "string"
    },
    "psychologist_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "scheduled"
    },
    "notes": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "online",
        "presencial"
      ],
      "default": "online"
    }
  },
  "required": [
    "student_id",
    "psychologist_id",
    "date",
    "time"
  ]
}
